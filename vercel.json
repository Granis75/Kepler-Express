{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kepler.anisconsult.com"
        }
      ],
      "destination": "https://kepler.lyanstudio.com/:path*",
      "permanent": true
    }
  ]
}
